{%- liquid
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant
  assign regular_price = variant.price

  assign has_selling_plans = false
  if product.selling_plan_groups.size > 0
    assign has_selling_plans = true
  endif
-%}

{%- if has_selling_plans -%}
  {%- liquid
    assign first_group = product.selling_plan_groups.first
    assign first_plan = first_group.selling_plans.first

    # Get subscribe price from selling plan allocations
    assign subscribe_price = regular_price
    for allocation in variant.selling_plan_allocations
      if allocation.selling_plan.id == first_plan.id
        assign subscribe_price = allocation.per_delivery_price
        break
      endif
    endfor

    assign has_discount = false
    if subscribe_price < regular_price
      assign has_discount = true
    endif
  -%}

  {%- capture selling_plan_json -%}[{%- for group in product.selling_plan_groups -%}{"name":{{ group.name | json }},"plans":[{%- for plan in group.selling_plans -%}{"id":"{{ plan.id }}","name":{{ plan.name | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}

  <pdp-purchase-options
    class="pdp-purchase-options"
    data-section-id="{{ section.id }}"
    data-selling-plan-groups='{{ selling_plan_json | strip }}'
    {{ block.shopify_attributes }}
  >
    <div class="pdp-purchase-options__card">
      <button
        type="button"
        class="pdp-purchase-options__option is-active"
        data-option-type="subscribe"
        on:click="/handleOptionSelect/subscribe"
        aria-label="{{ block.settings.subscribe_label }}"
      >
        <span class="pdp-purchase-options__radio-dot" role="radio" aria-checked="true"></span>
        <span class="pdp-purchase-options__option-label">
          <span class="pdp-purchase-options__option-title">{{ block.settings.subscribe_label }}</span>
        </span>
        <span class="pdp-purchase-options__option-price">
          {%- if has_discount -%}
            <span class="pdp-purchase-options__price-current">{{ subscribe_price | money }}</span>
            <s class="pdp-purchase-options__price-compare">{{ regular_price | money }}</s>
          {%- else -%}
            <span class="pdp-purchase-options__price-current">{{ regular_price | money }}</span>
          {%- endif -%}
        </span>
      </button>

      <div class="pdp-purchase-options__subscribe-details is-visible">
        <div class="pdp-purchase-options__sub-lines">
          {%- if block.settings.guarantee_text != blank -%}
            <span class="pdp-purchase-options__sub-line">{{ block.settings.guarantee_text }}</span>
          {%- endif -%}
          {%- if block.settings.cancel_text != blank -%}
            <span class="pdp-purchase-options__sub-line">{{ block.settings.cancel_text }}</span>
          {%- endif -%}
        </div>

        {%- if first_group.selling_plans.size > 1 -%}
          <div class="pdp-purchase-options__frequency is-visible" role="radiogroup" aria-label="Delivery frequency">
            {%- for plan in first_group.selling_plans -%}
              <button
                type="button"
                class="pdp-purchase-options__pill{% if forloop.first %} is-selected{% endif %}"
                role="radio"
                aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-pill-id="{{ plan.id }}"
                on:click="/handlePillSelect/{{ plan.id }}"
                on:keydown="/handlePillKeydown/{{ plan.id }}"
              >
                {{- plan.name -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="pdp-purchase-options__option"
        data-option-type="onetime"
        on:click="/handleOptionSelect/onetime"
        aria-label="{{ block.settings.onetime_label }}"
      >
        <span class="pdp-purchase-options__radio-dot" role="radio" aria-checked="false"></span>
        <span class="pdp-purchase-options__option-label">
          <span class="pdp-purchase-options__option-title">{{ block.settings.onetime_label }}</span>
        </span>
        <span class="pdp-purchase-options__option-price">
          <span class="pdp-purchase-options__price-current">{{ regular_price | money }}</span>
        </span>
      </button>
    </div>
  </pdp-purchase-options>

  <script src="{{ 'pdp-purchase-options.js' | asset_url }}" type="module"></script>
{%- else -%}
  <div
    class="pdp-purchase-options pdp-purchase-options--simple"
    {{ block.shopify_attributes }}
  >
    <span class="pdp-purchase-options__simple-label">{{ block.settings.onetime_label }}</span>
    <span class="pdp-purchase-options__simple-price">{{ regular_price | money }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .pdp-purchase-options__card {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
  }

  .pdp-purchase-options__option {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: 100%;
    padding: var(--padding-sm) var(--padding-md);
    background: none;
    border: none;
    cursor: pointer;
    text-align: start;
    font: inherit;
    color: inherit;
    transition: background-color var(--animation-speed-fast) var(--animation-easing);

    &:hover {
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-05));
    }

    &.is-active {
      background-color: rgb(var(--color-foreground-rgb) / var(--opacity-05));
    }
  }

  .pdp-purchase-options__option + .pdp-purchase-options__subscribe-details + .pdp-purchase-options__option,
  .pdp-purchase-options__option + .pdp-purchase-options__option {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .pdp-purchase-options__radio-dot {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgb(var(--color-foreground-rgb) / var(--opacity-30));
    position: relative;
    transition: border-color var(--animation-speed-fast) var(--animation-easing);

    &::after {
      content: '';
      position: absolute;
      top: 3px;
      left: 3px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--color-foreground);
      transform: scale(0);
      transition: transform var(--animation-speed-fast) var(--animation-easing);
    }

    &[aria-checked='true'] {
      border-color: var(--color-foreground);

      &::after {
        transform: scale(1);
      }
    }
  }

  .pdp-purchase-options__option-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pdp-purchase-options__option-title {
    font-weight: 600;
    font-size: var(--font-size--sm);
  }

  .pdp-purchase-options__option-price {
    display: flex;
    align-items: baseline;
    gap: var(--gap-2xs);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .pdp-purchase-options__price-current {
    font-weight: 600;
    font-size: var(--font-size--sm);
  }

  .pdp-purchase-options__price-compare {
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    text-decoration: line-through;
  }

  .pdp-purchase-options__subscribe-details {
    display: none;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));

    &.is-visible {
      display: block;
    }
  }

  .pdp-purchase-options__sub-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--padding-xs) var(--padding-md) 0;
    padding-inline-start: calc(var(--padding-md) + 18px + var(--gap-sm));
  }

  .pdp-purchase-options__sub-line {
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
  }

  .pdp-purchase-options__frequency {
    display: none;
    flex-wrap: wrap;
    gap: var(--gap-2xs);
    padding: var(--padding-xs) var(--padding-md) var(--padding-sm);

    &.is-visible {
      display: flex;
    }
  }

  .pdp-purchase-options__pill {
    padding: var(--padding-2xs) var(--padding-sm);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--radius-full, 999px);
    background: none;
    font: inherit;
    font-size: var(--font-size--xs);
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--animation-speed-fast) var(--animation-easing),
      background-color var(--animation-speed-fast) var(--animation-easing);

    &:hover {
      border-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    }

    &.is-selected {
      border-color: var(--color-foreground);
      background-color: var(--color-foreground);
      color: var(--color-background);
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }
  }

  .pdp-purchase-options--simple {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-sm);
  }

  .pdp-purchase-options__simple-label {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
  }

  .pdp-purchase-options__simple-price {
    font-weight: 600;
    font-size: var(--font-h4--size, 1.25rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Purchase options",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscribe label",
      "default": "Subscribe & Save 25%"
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "One-time label",
      "default": "One-time Purchase"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "100% satisfied or your money back"
    },
    {
      "type": "text",
      "id": "cancel_text",
      "label": "Cancel text",
      "default": "Plans to cancel any time"
    }
  ],
  "presets": [
    {
      "name": "Purchase options"
    }
  ]
}
{% endschema %}
