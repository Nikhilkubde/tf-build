{%- liquid
  assign product = closest.product

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign lore = product.metafields.custom.lore
  assign care = product.metafields.custom.care_instructions

  # Individual spec metafields
  assign spec_scale = product.metafields.custom.scale.value
  assign spec_height = product.metafields.custom.height.value
  assign spec_materials = product.metafields.custom.materials.value
  assign spec_articulation = product.metafields.custom.articulation_points.value
  assign spec_accessories = product.metafields.custom.included_accessories

  assign has_specs = false
  if spec_scale != blank or spec_height != blank or spec_materials != blank or spec_articulation != blank
    assign has_specs = true
  endif
  if spec_accessories.value != blank
    assign has_specs = true
  endif

  # Lore fallback: if no lore metafield, use product description paragraphs after the first
  assign has_lore = false
  assign lore_fallback_content = ''

  if lore.value != blank
    assign has_lore = true
  elsif product.description != blank
    assign desc_parts = product.description | split: '</p>'
    if desc_parts.size > 1
      assign has_lore = true
    endif
  endif

  assign has_any = false
  if has_lore or has_specs or care.value != blank
    assign has_any = true
  endif
-%}

{%- comment -%}
  Render accordion-custom-component once to ensure its stylesheet is loaded.
  Output is captured and discarded.
{%- endcomment -%}
{%- capture _void -%}
  {%- render 'accordion-custom-component', children: '' -%}
{%- endcapture -%}

{%- if has_any -%}
  <div
    class="pdp-accordions"
    data-pdp-accordion-persist
    data-product-handle="{{ product.handle }}"
    {{ block.shopify_attributes }}
  >
    {%- if has_lore -%}
      <accordion-custom id="pdp-accordion-lore">
        <details class="details">
          <summary class="details__header pdp-accordions__header">
            {{ block.settings.lore_heading }}
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>
          <div class="details-content pdp-accordions__body">
            <div class="rte">
              {%- if lore.value != blank -%}
                {%- if lore.type == 'rich_text_field' -%}
                  {{ lore | metafield_tag }}
                {%- elsif lore.type == 'multi_line_text_field' -%}
                  {{ lore.value | newline_to_br }}
                {%- else -%}
                  {{ lore.value }}
                {%- endif -%}
              {%- else -%}
                {%- for part in desc_parts -%}
                  {%- if forloop.first -%}{%- continue -%}{%- endif -%}
                  {%- assign trimmed_part = part | strip -%}
                  {%- if trimmed_part != blank -%}
                    {{ trimmed_part | append: '</p>' }}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        </details>
      </accordion-custom>
    {%- endif -%}

    {%- if has_specs -%}
      <accordion-custom id="pdp-accordion-specs" open-by-default-on-desktop>
        <details class="details" open>
          <summary class="details__header pdp-accordions__header">
            {{ block.settings.specs_heading }}
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>
          <div class="details-content pdp-accordions__body">
            <table class="pdp-accordions__specs-table">
              <tbody>
                {%- if spec_scale != blank -%}
                  <tr>
                    <th>Scale</th>
                    <td>{{ spec_scale }}</td>
                  </tr>
                {%- endif -%}
                {%- if spec_height != blank -%}
                  <tr>
                    <th>Height</th>
                    <td>{{ spec_height }}</td>
                  </tr>
                {%- endif -%}
                {%- if spec_materials != blank -%}
                  <tr>
                    <th>Materials</th>
                    <td>{{ spec_materials }}</td>
                  </tr>
                {%- endif -%}
                {%- if spec_articulation != blank -%}
                  <tr>
                    <th>Articulation Points</th>
                    <td>{{ spec_articulation }}</td>
                  </tr>
                {%- endif -%}
                {%- if spec_accessories.value != blank -%}
                  <tr>
                    <th>Included Accessories</th>
                    <td>
                      {%- assign acc_type = spec_accessories.type -%}
                      {%- if acc_type contains 'list' -%}
                        {{ spec_accessories.value | join: ', ' }}
                      {%- else -%}
                        {{ spec_accessories.value }}
                      {%- endif -%}
                    </td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>
          </div>
        </details>
      </accordion-custom>
    {%- endif -%}

    {%- if care.value != blank -%}
      <accordion-custom id="pdp-accordion-care">
        <details class="details">
          <summary class="details__header pdp-accordions__header">
            {{ block.settings.care_heading }}
            <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </summary>
          <div class="details-content pdp-accordions__body">
            <div class="rte">
              {%- if care.type == 'rich_text_field' -%}
                {{ care | metafield_tag }}
              {%- elsif care.type == 'multi_line_text_field' -%}
                {{ care.value | newline_to_br }}
              {%- else -%}
                {{ care.value }}
              {%- endif -%}
            </div>
          </div>
        </details>
      </accordion-custom>
    {%- endif -%}
  </div>

  <script src="{{ 'pdp-accordion-persist.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .pdp-accordions {
    display: flex;
    flex-direction: column;
  }

  .pdp-accordions accordion-custom + accordion-custom {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .pdp-accordions__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--padding-sm);
    font-weight: 600;
    font-size: var(--font-size--sm);
    cursor: pointer;
    user-select: none;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &::marker {
      display: none;
      content: '';
    }
  }

  .pdp-accordions__body {
    padding-block-end: var(--padding-sm);
    font-size: var(--font-size--sm);
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
  }

  .pdp-accordions__specs-table {
    width: 100%;
    border-collapse: collapse;

    th,
    td {
      padding: var(--padding-2xs) 0;
      text-align: start;
      font-size: var(--font-size--sm);
      border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-05));
    }

    th {
      font-weight: 600;
      width: 40%;
      color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    }

    td {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Accordions",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "lore_heading",
      "label": "First heading",
      "default": "Lore"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Second heading",
      "default": "Specs"
    },
    {
      "type": "text",
      "id": "care_heading",
      "label": "Third heading",
      "default": "Care & Display"
    }
  ],
  "presets": [
    {
      "name": "PDP Accordions"
    }
  ]
}
{% endschema %}
