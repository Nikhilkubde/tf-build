{%- if block.settings.show_trust_line -%}
  <div
    class="pdp-trust-line"
    {{ block.shopify_attributes }}
  >
    <svg class="pdp-trust-line__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M8 .5l5.234 2.15A.5.5 0 0113.5 3v4.401a6.5 6.5 0 01-3.354 5.688L8 14.25l-2.146-1.161A6.5 6.5 0 012.5 7.401V3a.5.5 0 01.266-.35L8 .5z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M5.5 8l1.667 1.5L10.5 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="pdp-trust-line__text">{{ block.settings.trust_text }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .pdp-trust-line {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .pdp-trust-line__icon {
    flex-shrink: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }

  .pdp-trust-line__text {
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust line",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_trust_line",
      "label": "Show trust line",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust text",
      "default": "Authentic collectible — satisfaction guaranteed"
    }
  ],
  "presets": [
    {
      "name": "Trust line"
    }
  ]
}
{% endschema %}
