{%- liquid
  assign product = closest.product
  assign rating_value = product.metafields.reviews.rating.value
  assign rating = rating_value.rating
  assign scale_max = rating_value.scale_max
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
    assign rating = 4.5
    assign scale_max = 5
    assign rating_count = 42
  endif
-%}

{%- if rating != blank -%}
  {%- liquid
    assign star_count = scale_max | default: 5
    assign decimal = rating | modulo: 1
    assign decimal_rating = 0

    if decimal >= 0.3 and decimal <= 0.7
      assign decimal_rating = 0.5
    elsif decimal > 0.7
      assign decimal_rating = 1
    endif

    assign decimal_rounded = decimal_rating | ceil
    assign svg_filled_stars = rating | floor | plus: decimal_rounded
  -%}

  <div
    class="pdp-review-row"
    {{ block.shopify_attributes }}
  >
    <svg
      class="visually-hidden"
      style="width: 0; height: 0;"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      role="presentation"
    >
      <defs>
        <linearGradient id="pdp-half-star" x1="0" x2="100%" y1="0" y2="0">
          <stop offset="50%" stop-color="currentColor"></stop>
          <stop offset="50%" stop-color="transparent"></stop>
        </linearGradient>
        <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="pdp-star">
          <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
        </symbol>
      </defs>
    </svg>

    <div
      class="pdp-review-row__stars"
      aria-label="{{ rating | round: 1 }} out of {{ scale_max }} stars"
    >
      {%- for star in (1..star_count) -%}
        <svg
          class="pdp-review-row__star {% if star <= svg_filled_stars %}pdp-review-row__star--filled{% endif %}"
          viewBox="0 0 32 32"
          role="presentation"
        >
          <use xlink:href="#pdp-star"{% if decimal_rating == 0.5 and star == svg_filled_stars %} fill="url(#pdp-half-star)"{% endif %}></use>
        </svg>
      {%- endfor -%}
    </div>

    <span class="pdp-review-row__rating">{{ rating | round: 1 }}</span>

    {%- if rating_count > 0 -%}
      <a href="#reviews" class="pdp-review-row__count">({{ rating_count }} reviews)</a>
    {%- else -%}
      <span class="pdp-review-row__count">No reviews yet — be the first</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .pdp-review-row {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    flex-wrap: wrap;
  }

  .pdp-review-row__stars {
    display: flex;
    align-items: center;
    gap: var(--gap-3xs);
  }

  .pdp-review-row__star {
    width: 1em;
    height: 1em;
    fill: rgb(var(--color-foreground-rgb) / var(--opacity-20));
  }

  .pdp-review-row__star--filled {
    fill: currentColor;
  }

  .pdp-review-row__rating {
    font-weight: 600;
    font-size: var(--font-size--sm);
  }

  .pdp-review-row__count {
    font-size: var(--font-size--sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-60));
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review row",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "stars_style",
      "label": "Stars style",
      "options": [
        {
          "value": "shaded",
          "label": "Shaded"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "shaded"
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Show review count",
      "default": true
    },
    {
      "type": "select",
      "id": "rating_color",
      "label": "Star color",
      "options": [
        {
          "value": "foreground",
          "label": "Text"
        },
        {
          "value": "primary",
          "label": "Primary"
        }
      ],
      "default": "foreground"
    }
  ],
  "presets": [
    {
      "name": "Review row"
    }
  ]
}
{% endschema %}
