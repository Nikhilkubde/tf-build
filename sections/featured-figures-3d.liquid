{%- comment -%}
  featured-figures-3d.liquid
  3D featured action figures section.

  Each product card can show an interactive <model-viewer> when a model URL is
  provided via the per-slot model_url_N settings. When the URL is blank the
  card falls back to the product's featured image with a CSS + JS tilt effect.

  Dynamic setting key lookup: uses Shopify Liquid bracket notation
  (section.settings[model_key]) to resolve model_url_1 … model_url_8 per slot.
{%- endcomment -%}

<div
  id="FeaturedFigures3D-{{ section.id }}"
  class="featured-figures-3d color-{{ section.settings.color_scheme }} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
  "
  data-gradient-shift
>
  <div class="featured-figures-3d__inner">

    {%- comment -%} Section header {%- endcomment -%}
    <div class="featured-figures-3d__header" data-reveal="slide-up">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-figures-3d__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="featured-figures-3d__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Product grid {%- endcomment -%}
    <div class="featured-figures-3d__grid">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.max_products -%}
          {%- comment -%}
            Resolve model URL for this slot via dynamic Liquid key lookup.
            model_url_1 … model_url_8 correspond to forloop.index 1 … 8.
          {%- endcomment -%}
          {%- assign model_key = 'model_url_' | append: forloop.index -%}
          {%- assign model_url = section.settings[model_key] -%}

          <div
            class="product-card-3d"
            data-reveal="fade"
            data-reveal-delay="{{ forloop.index0 | times: 120 }}"
            data-glow-hover
          >
            {%- comment -%} Media area: model-viewer or tilt image fallback {%- endcomment -%}
            <div class="product-card-3d__media">
              {%- if model_url != blank -%}
                <model-viewer
                  src="{{ model_url }}"
                  alt="{{ product.title | escape }}"
                  camera-controls
                  auto-rotate
                  auto-rotate-delay="1000"
                  shadow-intensity="0.8"
                  loading="lazy"
                  reveal="interaction"
                  class="product-card-3d__viewer"
                >
                  <div slot="poster" class="product-card-3d__poster">
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 600
                        | image_tag:
                          loading: 'lazy',
                          alt: product.featured_image.alt
                      }}
                    {%- endif -%}
                  </div>
                </model-viewer>
              {%- else -%}
                <div class="product-card-3d__image-wrap" data-tilt>
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        class: 'product-card-3d__image',
                        alt: product.featured_image.alt
                    }}
                  {%- else -%}
                    <div class="product-card-3d__image-placeholder"></div>
                  {%- endif -%}
                  <div class="product-card-3d__tilt-sheen" aria-hidden="true"></div>
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Card info {%- endcomment -%}
            <div class="product-card-3d__info">
              <a href="{{ product.url }}" class="product-card-3d__title">
                {{ product.title | escape }}
              </a>
              <span class="product-card-3d__price">{{ product.price | money }}</span>
              <a href="{{ product.url }}" class="button button-secondary product-card-3d__cta">
                View Details
              </a>
            </div>
          </div>
        {%- else -%}
          {%- comment -%} No products in collection — render placeholder cards {%- endcomment -%}
          {%- for i in (1..section.settings.max_products) -%}
            <div class="product-card-3d product-card-3d--placeholder">
              <div class="product-card-3d__media">
                <div class="product-card-3d__image-placeholder"></div>
              </div>
              <div class="product-card-3d__info">
                <span class="product-card-3d__title">Product title</span>
                <span class="product-card-3d__price">$0.00</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} No collection selected — render placeholder cards {%- endcomment -%}
        {%- for i in (1..section.settings.max_products) -%}
          <div class="product-card-3d product-card-3d--placeholder">
            <div class="product-card-3d__media">
              <div class="product-card-3d__image-placeholder"></div>
            </div>
            <div class="product-card-3d__info">
              <span class="product-card-3d__title">Product title</span>
              <span class="product-card-3d__price">$0.00</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</div>

{%- comment -%} Load Google model-viewer CDN script (ES module — browser deduplicates by URL) {%- endcomment -%}
{% # theme-check-disable RemoteAsset %}
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>
{% # theme-check-enable RemoteAsset %}

{%- comment -%} Per-section manager for tilt, load state, and reduced-motion guard {%- endcomment -%}
<script type="module" src="{{ 'model-viewer-manager.js' | asset_url }}"></script>

{% stylesheet %}
  /* ─── Section wrapper ─────────────────────────────────────────────────────── */

  .featured-figures-3d {
    position: relative;
  }

  .featured-figures-3d__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Animated gradient overlay via ::before pseudo-element */
  .featured-figures-3d::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      135deg,
      rgba(var(--color-primary), 0) 0%,
      rgba(var(--color-primary), 0.06) 50%,
      rgba(var(--color-primary), 0) 100%
    );
    background-size: 300% 300%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .featured-figures-3d.gradient-animating::before {
    opacity: 1;
    animation: gradient-shift 10s ease infinite;
  }

  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-figures-3d.gradient-animating::before {
      animation: none;
      opacity: 0;
    }
  }

  /* ─── Section header ──────────────────────────────────────────────────────── */

  .featured-figures-3d__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;

    &.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-figures-3d__header {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .featured-figures-3d__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground-heading, var(--color-foreground)));
  }

  .featured-figures-3d__subheading {
    margin: 0;
    font-size: 1rem;
    color: rgb(var(--color-foreground));
    opacity: 0.75;
  }

  /* ─── Product grid ────────────────────────────────────────────────────────── */

  .featured-figures-3d__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 24px;
    }
  }

  /* ─── Product card ────────────────────────────────────────────────────────── */

  .product-card-3d {
    --glow-opacity: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-radius: 12px;
    overflow: hidden;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(var(--color-primary), 0);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    opacity: 0;

    &.is-revealed {
      opacity: 1;
      transition: opacity 0.5s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }

    &:hover {
      box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.12),
        0 0 30px rgba(var(--color-primary), calc(var(--glow-opacity) * 0.25)),
        0 0 0 1px rgba(var(--color-primary), calc(var(--glow-opacity) * 0.3));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card-3d {
      opacity: 1;
      transition: box-shadow 0.3s ease;
    }
  }

  .product-card-3d--placeholder {
    opacity: 0.4;
  }

  /* ─── Card media area ─────────────────────────────────────────────────────── */

  .product-card-3d__media {
    width: 100%;
    overflow: hidden;
  }

  /* model-viewer */
  .product-card-3d__viewer {
    width: 100%;
    aspect-ratio: 3 / 4;
    display: block;
    background: transparent;
    transition: opacity 0.5s ease;

    &.model-viewer--error {
      opacity: 0.3;
    }
  }

  .product-card-3d__poster {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  /* Image-with-tilt fallback */
  .product-card-3d__image-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .product-card-3d__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Sheen overlay for tilt effect */
  .product-card-3d__tilt-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, transparent 60%);
    pointer-events: none;
    z-index: 1;
  }

  /* Generic placeholder when no image */
  .product-card-3d__image-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: rgba(var(--color-foreground), 0.08);
  }

  /* ─── Card info ───────────────────────────────────────────────────────────── */

  .product-card-3d__info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
  }

  .product-card-3d__title {
    display: block;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    text-decoration: none;
    line-height: 1.3;
    overflow-wrap: break-word;

    &:hover {
      color: rgb(var(--color-primary));
    }
  }

  .product-card-3d__price {
    display: block;
    font-size: 0.95rem;
    color: rgb(var(--color-foreground));
    opacity: 0.85;
  }

  .product-card-3d__cta {
    align-self: flex-start;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D Featured Figures",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Action Figures"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Rotate. Zoom. Bring them home."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "3D Model URLs"
    },
    {
      "type": "paragraph",
      "content": "Leave a URL blank to show the product image with a tilt effect. Use .glb or .gltf format. Placeholder models are CC0 from modelviewer.dev — replace before going live."
    },
    {
      "type": "text",
      "id": "model_url_1",
      "label": "Model URL — slot 1",
      "default": "https://modelviewer.dev/shared-assets/models/Astronaut.glb"
    },
    {
      "type": "text",
      "id": "model_url_2",
      "label": "Model URL — slot 2",
      "default": "https://modelviewer.dev/shared-assets/models/RobotExpressive.glb"
    },
    {
      "type": "text",
      "id": "model_url_3",
      "label": "Model URL — slot 3"
    },
    {
      "type": "text",
      "id": "model_url_4",
      "label": "Model URL — slot 4"
    },
    {
      "type": "text",
      "id": "model_url_5",
      "label": "Model URL — slot 5"
    },
    {
      "type": "text",
      "id": "model_url_6",
      "label": "Model URL — slot 6"
    },
    {
      "type": "text",
      "id": "model_url_7",
      "label": "Model URL — slot 7"
    },
    {
      "type": "text",
      "id": "model_url_8",
      "label": "Model URL — slot 8"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "3D Featured Figures"
    }
  ]
}
{% endschema %}
